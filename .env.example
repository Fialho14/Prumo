# Copia este ficheiro para .env.local e remove apenas o # das opções que queres usar.
# Nunca coloques aqui a password do volume: é o macOS que o desbloqueia.

# Base de dados privada (caminho absoluto).
# O diretório pai tem de existir. Se o volume estiver desmontado, o Prumo mostra um
# erro e não cria silenciosamente outra base de dados noutro local.
# FINANCE_DB_PATH="/Volumes/NOME_DO_DISCO/Financas/finance.db"

# Backups locais (caminho absoluto). Sem esta opção, ficam na pasta `backups`
# ao lado da base de dados.
# FINANCE_BACKUP_PATH="/Volumes/NOME_DO_DISCO/Financas/backups"

# Dependências e cache de compilação. O valor por omissão já fica fora do volume:
# ~/Library/Application Support/Prumo/runtime
# PRUMO_RUNTIME_DIR="/caminho/absoluto/para/runtime"
