{
  "name": "prumo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, local-first net worth tracking in the browser or with SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fialho14/patrimonio.git"
  },
  "bugs": {
    "url": "https://github.com/Fialho14/patrimonio/issues"
  },
  "homepage": "https://github.com/Fialho14/patrimonio#readme",
  "keywords": [
    "local-first",
    "net-worth",
    "privacy",
    "sqlite",
    "spreadsheet"
  ],
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "web:test": "vitest run --config apps/web/vitest.config.ts",
    "finance": "node scripts/finance.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run web:test && npm run web:build && npm run build",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.0",
    "eslint-config-next": "16.3.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
